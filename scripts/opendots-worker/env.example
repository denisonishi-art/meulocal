# Names/placeholders only. Configure real values securely outside Git.
CPK_INTELLIGENCE_API_KEY=
OPENAI_API_KEY=
MEULOCAL_PROSPECTOR_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
MEULOCAL_PROSPECTOR_ENDPOINT=https://meulocal.ia.br/api/agents/prospecting
MEULOCAL_RESEARCH_LIMIT=5
OPENDOTS_EXECUTION_MODE=intelligence
# Optional paths supplied by the deployment host.
OPENDOTS_ROOT=.opendots/upstream
OPENDOTS_DATA_DIR=.opendots/data
OPENDOTS_OUTPUT_DIR=.opendots/results

MEULOCAL_RESEARCH_SEGMENT=geradores
# Server-only gates: enable only after approved preview validation. Never export to worker.
# MEULOCAL_RESEARCH_ENABLED
# MEULOCAL_RESEARCH_ELIGIBILITY_ENABLED
